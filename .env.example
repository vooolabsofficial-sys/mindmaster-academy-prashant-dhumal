# ==============================================================================
# MindMaster Academy — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Postgres & Auth Configuration
# ------------------------------------------------------------------------------
# URL of your Supabase Project (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Public Key (Safe for browser / client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Secret (CRITICAL: Keep server-side only for webhooks and admin tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret

# ------------------------------------------------------------------------------
# 2. Authentication & Session Cookie Sharing
# ------------------------------------------------------------------------------
# Allows session cookie sharing between app.mindmasteracademy.com and www.mindmasteracademy.com
# For local development, leave blank or comment out
NEXT_PUBLIC_COOKIE_DOMAIN=.mindmasteracademy.com

# Canonical URL of the web app
NEXT_PUBLIC_APP_URL=https://app.mindmasteracademy.com

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Razorpay Key ID (Visible to client, starts with rzp_test_ or rzp_live_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId

# Razorpay Secret (Server-side HMAC verification and order generation)
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# ------------------------------------------------------------------------------
# 4. Staff & Owner Initial Seeding (Phase-2 Migration)
# ------------------------------------------------------------------------------
OWNER_PHONE=+919822012345
OWNER_TEMP_PASSWORD=Owner@2026
NEXT_PUBLIC_OWNER_PHONE=+919822012345
NEXT_PUBLIC_OWNER_TEMP_PASSWORD=Owner@2026

